{
  "name": "@scatool/analyzer-test-utils",
  "version": "0.0.5",
  "repository": {
    "type": "git",
    "url": "https://github.com/scatool/excalibur.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com",
    "tag": "alpha"
  },
  "scripts": {
    "test": "vp test run --passWithNoTests",
    "typecheck": "vp run check",
    "build": "vp pack",
    "dev": "vp pack --watch",
    "prepublishOnly": "vp run build",
    "check": "vp exec tsc --strict --noEmit"
  },
  "dependencies": {
    "@scatool/analyzer-core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "typescript": "^5",
    "vitest": "^4"
  }
}
