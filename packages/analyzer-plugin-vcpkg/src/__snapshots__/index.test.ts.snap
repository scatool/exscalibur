                  ],
                  "description": "TLS support (gnutls)",
                },
                "gsasl": {
                  "dependencies": [
                    "gsasl",
                  ],
                  "description": "GSASL support (libgsasl)",
                },
                "gssapi": {
                  "dependencies": [
                    "krb5",
                  ],
                  "description": "krb5 support",
                  "supports": "!windows",
                },
                "http2": {
                  "dependencies": [
                    {
                      "default-features": false,
                      "features": [
