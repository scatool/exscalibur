                      ],
                      "name": "curl",
                    },
                    "nghttp2",
                  ],
                  "description": "HTTP2 support",
                },
                "http3": {
                  "dependencies": [
                    {
                      "default-features": false,
                      "features": [
                        "openssl",
                      ],
                      "name": "curl",
                    },
                    "nghttp3",
                    {
                      "default-features": false,
                      "features": [
                        "openssl",
                      ],
                      "name": "ngtcp2",
                    },
                  ],
                  "description": "HTTP3 support with ngtcp2 on openssl",
                },
                "httpsrr": {
                  "description": "enable support for HTTPS RR",
                },
                "idn": {
                  "dependencies": [
                    {
                      "default-features": false,
                      "features": [
                        "winidn",
                      ],
                      "name": "curl",
                      "platform": "windows",
                    },
                    {
                      "default-features": false,
                      "features": [
                        "idn2",
                      ],
                      "name": "curl",
                      "platform": "!windows",
                    },
                  ],
                  "description": "Default IDN support",
                },
                "idn2": {
                  "dependencies": [
                    "libidn2",
                  ],
                  "description": "idn2 support (libidn2)",
                },
