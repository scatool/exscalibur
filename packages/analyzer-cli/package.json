{
  "name": "@scatool/analyzer-cli",
  "version": "0.1.0-alpha.2",
  "homepage": "https://github.com/scatool/exscalibur",
  "bugs": {
    "url": "https://github.com/scatool/exscalibur/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scatool/exscalibur.git",
    "directory": "packages/analyzer-cli"
  },
  "bin": {
    "exscalibur": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "dist/cli.d.mts",
  "exports": {
    ".": "./dist/cli.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org",
    "tag": "alpha"
  },
  "scripts": {
    "typecheck": "vp run check",
    "build": "vp pack",
    "dev": "vp pack --watch",
    "prepublishOnly": "vp run build",
    "check": "vp exec tsc --strict --noEmit",
    "test": "vp test run --passWithNoTests"
  },
  "dependencies": {
    "@scatool/analyzer-core": "workspace:*",
    "@scatool/analyzer-plugin-cdx": "workspace:*",
    "@scatool/analyzer-plugin-containers": "workspace:*",
    "@scatool/analyzer-plugin-github-actions": "workspace:*",
    "@scatool/analyzer-plugin-go": "workspace:*",
    "@scatool/analyzer-plugin-gradle": "workspace:*",
    "@scatool/analyzer-plugin-javascript": "workspace:*",
    "@scatool/analyzer-plugin-maven": "workspace:*",
    "@scatool/analyzer-plugin-ort": "workspace:*",
    "@scatool/analyzer-plugin-python": "workspace:*",
    "@scatool/analyzer-plugin-rust": "workspace:*",
    "@scatool/analyzer-plugin-spdx": "workspace:*",
    "@scatool/analyzer-plugin-uv": "workspace:*",
    "commander": "^15.0.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=22"
  }
}
