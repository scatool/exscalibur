{
  "name": "@scatool/analyzer",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "workspaces": [
    "./packages/*",
    "./test"
  ],
  "scripts": {
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "lint": "eslint .",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "prepare": "husky"
  },
  "lint-staged": {
    "*": "oxfmt --no-error-on-unmatched-pattern"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.0.2",
    "globals": "^17.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.4",
    "oxfmt": "^0.51.0",
    "prettier": "^3.8.1",
    "turbo": "^2.8.11",
    "typescript-eslint": "^8.56.1"
  },
  "packageManager": "bun@1.3.10"
}
