{
  "name": "@scatool/analyzer",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "workspaces": [
    "./packages/*"
  ],
  "scripts": {
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "eslint": "^9.38.0",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.6",
    "prettier": "^3.6.2",
    "turbo": "^2.5.8",
    "typescript-eslint": "^8.46.2"
  },
  "packageManager": "bun@1.3.1"
}
