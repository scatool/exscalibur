{
  "compilerOptions": {
    "noEmit": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"],
    "target": "ES2023",
    "lib": ["ES2023", "ESNext.Collection", "ESNext.Iterator"]
  }
}
